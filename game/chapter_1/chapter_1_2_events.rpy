        a "Может в лаборантской есть что-то полезное?"
    elif companion == "mari":
        show mari smile at left
        m "Может в лаборантской есть что-то полезное?"
    elif companion == "sylvia":
        show sylvia smile at left
        sy "Может в лаборантской есть что-то полезное?"
    elif companion == "shinna":
        show shinna smile at left
        s "Может в лаборантской есть что-то полезное?"

    n "Лаборантская внутри похожа на свалку"
    n "Куча каких-то бумажек, учебников и тетрадей"
    n "На рабочем столе помимо прочего стоит несколько микроскопов."

    if leon_intellect >= 2:
        n "..."
        with dissolve

        if companion == "alice":
            a "Смотри, это какая-то лабораторная..."
            a "Про земноводных?"
        elif companion == "mari":
            m "Смотри, это какая-то лабораторная..."
            m "Про земноводных?"
        elif companion == "sylvia":
            sy "Смотри, это какая-то лабораторная..."
            sy "Про земноводных?"
        elif companion == "shinna":
            s "Смотри, это какая-то лабораторная..."
            s "Про земноводных?"

        l "Да, кажется у меня она должна быть в следующую среду..."

        n "Леон пробегается взглядом по листку."
        n "«Земноводные (амфибии) — класс позвоночных животных, включающий лягушек, жаб, тритонов и саламандр."
        n "Основные признаки: гладкая влажная кожа, подвижные веки, хладнокровность и необходимость воды для размножения."
        n "Амфибии занимают промежуточное положение между водными и наземными животными, из-за чего обладают рядом уязвимостей."
        n "К основным слабостям относятся зависимость от влажной среды, проницаемая кожа, чувствительность к пересыханию и низкая активность при понижении температуры»."

        l "Хм..."
        l "Думаю, это может пригодиться на уроке."

        l "Чтож..."
        l "Это было познавательно..."

    if companion == "alice":
        a "Похоже это все, можем идти дальше..."
    elif companion == "mari":
        m "Похоже это все, можем идти дальше..."
    elif companion == "sylvia":
        sy "Похоже это все, можем идти дальше..."
    elif companion == "shinna":
        s "Похоже это все, можем идти дальше..."

    return


