label ch1_2_biology:
    scene bg biology
    with dissolve

    "Локация: Кабинет биологии"

    l "Предлагаю зайти в кабинет биологии..."

    n "По всему кабинету красуются огромные папоротники..."
    n "На стене можно заметить плакат со строением клетки..."
    n "На столе учителя красуется макет собаки"

    if companion == "alice":
        show alice smile at left
        a "Вроде никого нет..."
    elif companion == "mari":
        show mari smile at left
        m "Вроде никого нет..."
    elif companion == "sylvia":
        show sylvia smile at left
        sy "Вроде никого нет..."
    elif companion == "shinna":
        show shinna smile at left
        s "Вроде никого нет..."

    n "..."
    with dissolve

    show helena smile at right
    h "Леон!"

    h "Ты же знал, что тот скелет в шкафу это не просто муляж?"
    h "По легенде при заливке фундамента школы был найден закопанный труп"
    h "Основатель школы не хотел проблем с законом и представил его как экспонат"
    h "И дух этого несчастного теперь бродит по кабинету биологии..."
    h "Только представь, быть убитым и захороненным..."
    h "А спустя несколько лет твои останки раскапывают и выставляют на показ..."

    l "Да, звучит ужасно..."
    l "Не разве не тоже самое мы делаем с мамонтами и динозаврами?"
    l "А если серьезно, то не время для твоих легенд"
    l "Проблем итак хватает...."

    n "Мистика Леона увеличивается на 1"
    $ leon_mystic += 1

    l "Хорошо, думаю можем идти дальше..."

    return


label ch1_2_laboratory:
