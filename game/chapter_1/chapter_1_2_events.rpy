label ch1_2_robotics:
    scene bg robotics
    with dissolve

    "Локация: Кабинет кружка робототехники"

    l "Это кружок робототехники?"
    l "Может зайдем?"

    if companion == "alice":
        show alice smile at left
        a "Почему бы и нет..."
    elif companion == "mari":
        show mari smile at left
        m "Почему бы и нет..."
    elif companion == "sylvia":
        show sylvia smile at left
        sy "Почему бы и нет..."
    elif companion == "shinna":
        show shinna smile at left
        s "Почему бы и нет..."

    n "В кабинете кружка Леон замечает кучу каких-то плат и микросхем"

    l "Опа, а это паяльник..."
    l "Может его можно использовать как оружие?"

    if companion == "alice":
        a "Леон!"
        a "Электричества все еще нет..."
        a "Ты забыл?"
    elif companion == "mari":
        m "Леон!"
        m "Электричества все еще нет..."
        m "Ты забыл?"
    elif companion == "sylvia":
        sy "Леон!"
        sy "Электричества все еще нет..."
        sy "Ты забыл?"
    elif companion == "shinna":
        s "Леон!"
        s "Электричества все еще нет..."
        s "Ты забыл?"

    n "..."
    with dissolve

    if companion != "alice":
        show alice smile at right

    a "Для работы этого паяльника нужно 220 вольт!"
    a "Конечно существуют и более безопасные низковольтные модели..."
    a "Но этот явно не из таких."

    l "Алиса?"
    l "Сейчас?"

    a "Это помогает мне успокоиться..."

    l "Ладно, ладно."
    l "Но если бы электричество работало..."
    l "И мы включили паяльник в розетку,"
    l "то это будет последовательное соединение?"

    a "Нет, параллельное."
    a "В обычной проводке почти все приборы подключаются параллельно."
    a "Иначе выключенный чайник оставлял бы тебя без света во всей квартире."

    l "Звучит логично..."

    a "При параллельном соединении каждое устройство работает независимо от остальных."
    a "И напряжение на розетке остается одинаковым для всех подключенных приборов."

    l "Пожалуй, я начинаю понимать, почему ты так любишь физику."

    n "Интеллект Леона увеличивается на 1."
    $ leon_intellect += 1

    l "Думаю здесь больше ничего интересного..."
    l "Можем идти дальше..."

    return


