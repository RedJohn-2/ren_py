    n "Но поскальзывается на разлитом масле..."
    n "И натыкается прямо на маску..."
    $ set_possessed(companion, 'kara')
    l "Постой!"
    n "Леон пытается поймать девушку..."
    n "Но поскальзывается сам..."
    n "Неожиданно девушка исчезает..."
    l "Девушка!"
    l "И куда она подевалась..."
    l "..."
    l "Ух..."
    n "В Леона самого из воздуха начинают лететь тарелки..."
    l "Так..."
    l "Надо выбираться..."
    n "Леон перепрыгивает через раздаточный стол и возвращается в столовую..."
    l "Так..."
    l "Ну и где же ты?"
    python:
        try:
            renpy.show(companion + " mask kara")
        except Exception:
            pass
    kara "Ха?"
    kara "Ничтожество..."
    kara "И как ты планируешь меня победить?.."
    n "В Леона начинают лететь стулья и столовые приборы..."

    return

label ch4_2_kara_fight:
    scene bg cafeteria
    with dissolve
    python:
        try:
            renpy.show(companion + " mask kara")
        except Exception:
            pass

    call parry(items=[("Уклониться влево","left"), ("Уклониться вправо","right")], prompt="Летящий стул!")

    if _return == "__miss__":
        $ leon_take_wound()
        n "Стул попадает в Леона..."
    else:
        n "Леон уворачивается от летящего стула..."

    kara "Жалкий смертный..."

    call parry(items=[("Отбить тарелку","hit"), ("Присесть","duck")], prompt="Град тарелок!")

    if _return == "__miss__":
        $ leon_take_wound()
        n "Тарелка разбивается о плечо Леона..."
    else:
        n "Леон уклоняется от града тарелок..."

    l "Довольно!"
    n "Сквозь мелькание тарелок Леон различает силуэт девушки..."
    n "Он бросается вперед и хватает маску..."
    n "Изо всех сил срывает ее с лица..."
    $ break_mask('kara')
    kara "Нет!.."
    n "Маска раскалывается в его руках..."
    n "Девушка падает на пол без сознания..."
    n "Через мгновение она открывает глаза..."
    companion_char "Леон?.."
    companion_char "Что произошло?.."
    l "Все позади..."
    l "Ты в порядке..."
    $ mark_saved(companion)

    return
