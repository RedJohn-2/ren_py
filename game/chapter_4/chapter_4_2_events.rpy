    call parry(items=[("Ударить по лезвию","hit"), ("Ударить по руке","arm")], prompt="Повар замахивается тесаком!")

    if _return == "hit":
        n "Тесак выскальзывает из рук шефа и втыкается в столешницу..."
        chef "Вуа?"
        n "Сам повар от инерции удара падает и натыкается головой на свой тесак..."
    else:
        $ leon_take_wound()
        n "Леон не успевает отбить удар..."
        n "Тесак ранит Леона, но шеф теряет равновесие..."
        n "Повар падает и натыкается на собственный тесак..."

    l "Шеф!.."
    companion_char "Аааааа!"

    return

