# Chapter 2.2: Room exploration events
# Основан на файле "Диалоги/Глава 2.2.md"

label ch2_2_literature:
    scene bg literature
    with dissolve

    show expression companion + " smile"


    l "Может зайдем в кабинет литературы?"

    companion_char "Почему бы и нет..."

    n "Леон медленно отворяет дверь в кабинет..."
    n "С стен на него смотрят портреты писателей..."

    l "Меня всегда пугал этот их взгляд..."
    l "Аж немного передергивает..."

    companion_char "Ага, а в текущей обстановке это заиграло новыми красками..."

    l "Давай быстренько все осмотрим..."
    l "Как-то не хочется задерживаться..."

    if companion == "mari":
        show mari opensmile
        m "Леон..."
        m "А ты никогда не думал вступить в литературный кружок?"
        m "Мне кажется, у него есть какая-то особая атмосфера..."
        m "Что-то очень доброе и..."
        m "Милое"
        show mari smile
        l "О чем ты, Мари?"
        m "Ну, понимаешь стихи..."
        m "Романтика..."
        m "Может философия..."
        m "Вложить в стихотворение чувства или какой-то потаенный смысл..."
        m "Ах... Искусство..."
        l "Да"
        l "Я кажется понимаю..."
        $ stat_add('leon','empathy',1)
    else:
        n "Леон и девушка проходят между рядами..."
        n "Но не замечают ничего интересного..."

    l "Похоже ничего..."
    l "Можем идти дальше..."

    return

label ch2_2_music:
    scene bg music
    with dissolve

    show expression companion + " smile"


    companion_char "О, кабинет музыки..."
    companion_char "Может зайдем?"

    l "Давай..."

    n "В кабинете героев встречает огромное пианино."
    n "И несколько нотных тетрадей..."

    companion_char "Похоже, здесь даже спрятаться негде..."
    companion_char "Посмотри, похоже это тема из Тетриса..."
    companion_char "Ты вроде когда-то учился играть..."

    l "Да, но..."
    l "Мне кажется, сейчас не лучшее время."
    l "Мы же вроде хотели не шуметь..."

    companion_char "Ну пожалуйста..."
    companion_char "Я всегда мечтала послушать, как ты играешь..."

    l "Ладно, только быстро..."

    n "Перед Леоном две нотные тетради."

    menu:
        "Выберите ноты для игры:"

        "Тема из Тетриса — знакомые ноты, уверенная игра":
            n "Леон уверенно играет знакомую мелодию..."
            n "Пальцы сами находят нужные клавиши."
            n "Мелодия льется легко и правильно."

            companion_char "Леон, это просто восхитительно..."
            companion_char "Почему ты бросил?"

            n "Что-то щелкает в боковой стенке пианино..."
            n "Открывается потайной отсек..."
            n "В нем лежит аптечка первой помощи."

            companion_char "Стоп, что?"
            companion_char "Мы нашли тайник Ари-Сэмпай?"
            companion_char "Почему она хранит аптечку в пианино?"
            companion_char "Да и откуда вообще в пианино потайной отсек?"

            l "Думаю, лучше не задавать лишних вопросов..."
            l "А вот аптечка лишней не будет."

            call acquire_item('medkit')

        "Сыграть по памяти — рискованный вариант":
            n "Леон пытается вспомнить мелодию..."
            n "Пальцы путаются в клавишах."
            n "Несколько раз он сбивается и начинает заново."
            n "В итоге мелодия звучит, но с ошибками."

            companion_char "Леон, ты отлично играешь..."

            l "Нет, я уже подзабыл ноты."
            l "Но все равно спасибо..."
            l "Было приятно вспомнить былое."

    l "Что ж..."
    l "Думаю, здесь мы закончили."
    l "Можем идти дальше."

    return

label ch2_2_drafting:
    scene bg drafting
    with dissolve

    show expression companion + " smile"


    l "Это что? Кабинет черчения?"
    l "Ни разу здесь не был..."

    companion_char "Неудивительно..."
    companion_char "Предмет довольно непростой..."
    companion_char "Он только для третьего класса старшей школы."
    companion_char "Ну давай зайдем."

    l "Воу..."
    l "А я думал, это просто ИЗО для взрослых..."
    l "А здесь какие-то чертежи и схемы..."
    l "Это точно не подпольный завод по изготовлению деталей?"

    companion_char "Мда..."
    companion_char "Очень остроумно."
    companion_char "..."
    companion_char "Нашел что-нибудь?"

    l "Ну, не знаю..."
    l "Вот какая-то карта..."

    if companion == "shinna":
        show shinna smile
        s "Ох, Леон..."
        s "Это схема первого этажа..."
        s "План эвакуации..."
        s "Смотри, вот эти квадраты — кабинеты."
        s "Стрелочки — направление движения."
        s "А синие кружочки — выходы."
        l "Ого"
        l "Никогда не понимал, как их читать..."
        l "Самое сложное всегда было найти себя на схеме..."
        $ stat_add('leon','organization',1)
    else:
        companion_char "Что это?"
        companion_char "План эвакуации..."
        companion_char "Не думаю, что он нам понадобится..."

    call acquire_item('map_floor_1')

    l "Похоже, здесь больше ничего интересного..."
    l "Пойдем дальше..."

    return

label ch2_2_janitor:
    scene bg janitor
    with dissolve

    show expression companion + " smile"


    l "Какая-то темная комната..."

    companion_char "Это что-то вроде кладовки уборщицы..."
    companion_char "Для всяких швабр, моющих средств и прочего."
    companion_char "Думаешь, там может быть что-то полезное?"

    l "Ну давай посмотрим..."

    companion_char "Мда..."
    companion_char "Ну и свалка здесь, конечно..."

    if group_meets('organization', 3):
        l "Согласен..."
        l "Аж смотреть больно..."
        l "Пора навести порядок в этом бардаке."
        n "..."
        companion_char "Смотри!"
        companion_char "Огнетушитель!"
        companion_char "Почти новый..."
        companion_char "Может возьмем?"
        l "..."
        l "Да..."
        l "Конечно возьмем!"
        call acquire_item('fire_extinguisher')
    else:
        companion_char "Похоже, здесь ловить нечего..."

    l "Ладно..."
    l "Пойдем отсюда..."

    return

label ch2_2_workshop:
    scene bg workshop
    with dissolve

    show expression companion + " smile"


    companion_char "Ух ты!"
    companion_char "Мастерская..."
    companion_char "Интересно, что вы делаете на уроках технологии?"

    l "Что-то строгаем, пилим, вытачиваем..."

    companion_char "Мм..."
    companion_char "Может мы здесь найдем оружие?"

    l "Не, не думаю..."
    l "Видишь вон тот сейф?"
    l "Трудовик прячет все инструменты там."
    l "Техника безопасности, все такое..."

    companion_char "Что ж..."
    companion_char "Очень жаль..."

    if companion == "sylvia":
        show sylvia open
        sy "Ой, что это!"
        sy "Деревянный манекен!"
        show sylvia smile
        sy "Всегда мечтала о таком..."
        n "Сильвия начинает отрабатывать удары на манекене..."
        l "Сильви, это..."
        l "Экспериментальная вешалка Ойши-Сэмпая..."
        l "Думаю, он будет недоволен, если ты его сломаешь."
        show sylvia smile blush
        sy "Ой..."
        sy "Прости..."
        $ stat_add('leon','strength',1)
    else:
        companion_char "Похоже, здесь ничего интересного..."
        companion_char "Давай поторопимся."

    return

label ch2_2_continue:
    scene bg gym
    with dissolve

    n "Герои подходят к спортивному залу."

    if companion == "sylvia":
        show sylvia smile
        sy "Вот я снова здесь..."
        sy "Пора продолжить тренировку."

    return
