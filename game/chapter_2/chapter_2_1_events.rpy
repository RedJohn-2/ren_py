label ch2_1_no_diary:
    scene bg corridor
    with dissolve


    l "[[Эти демоны...]"
    l "[[И маски...]"
    l "[[Должно быть тот Дневник как-то с этим связан...]"
    l "[[Думаю стоит вернуться за ним и уже потом продолжить путь]"

    n "Леон отправляется по освещенному коридору прямиком в актовый зал..."

    scene bg assembly_hall
    with dissolve


    l "[[Отлично, я на месте...]"
    l "[[Лампочка в подсобке взорвалась...]"
    l "[[Придется снова использовать зажигалку]"

    n "Леон щелкает зажигалкой и заходит внутрь..."

    scene bg storage_room
    with dissolve


    l "Отлично, вот и он..."

    call acquire_item('occult_diary')

    l "[[Но куда делись все маски?]"
    l "[[И почему одна из них оказалась в Генераторной?]"

    n "Леон убирает Дневник в рюкзак и возвращается в коридор."

    scene bg corridor
    with dissolve


    return

